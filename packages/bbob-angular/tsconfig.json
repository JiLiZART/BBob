{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./es",
    "declarationDir": "./types",
    "declaration": true,
    "declarationMap": true,
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["dom", "es2022"],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": false
  },
  "angularCompilerOptions": {
    "compilationMode": "partial",
    "strictTemplates": true
  },
  "include": [
    "./src/**/*"
  ]
}
